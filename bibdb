        BIBTEXPARSER_V2 = True
    elif hasattr(bibtexparser, 'parse_string'): 
        # バージョン番号がない場合でも、v2特有の関数があればv2とみなす
        BIBTEXPARSER_V2 = True
        
except ImportError:
