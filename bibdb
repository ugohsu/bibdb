BIBTEXPARSER_AVAILABLE = False
BIBTEXPARSER_V2 = False

try:
    import bibtexparser
    BIBTEXPARSER_AVAILABLE = True
    
    # バージョン判定 (v2系はメジャーバージョンが2、または構造が大きく異なる)
