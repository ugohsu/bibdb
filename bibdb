def _read_keys_from_args_or_stdin(args) -> List[str]:
    keys: List[str] = []

    # 1. コマンドライン引数から取得 (例: bibdb delete Key1 Key2)
    if hasattr(args, "keys_pos") and args.keys_pos:
        keys.extend(args.keys_pos)

    # 2. ファイル指定 (--keys) から取得
    if getattr(args, "keys", None):
        if os.path.exists(args.keys):
            with open(args.keys, "r", encoding="utf-8") as f:
                keys.extend([line.strip() for line in f if line.strip()])
        else:
            sys.stderr.write(f"Error: File not found: {args.keys}\n")

    # 3. パイプ入力 (stdin) から取得
    # 対話モード(isatty=True)の場合は入力を待ってしまうため読み込まない
    if not sys.stdin.isatty():
        keys.extend([line.strip() for line in sys.stdin if line.strip()])

    # 重複除去（順序保持）
    seen = set()
    uniq = []
    for k in keys:
        if k not in seen:
            seen.add(k)
            uniq.append(k)
    return uniq

def cmd_delete(args):
    conn = get_connection()
    init_db(conn) # 安全のため初期化を実行
    cur = conn.cursor()

    target_keys = _read_keys_from_args_or_stdin(args)
    if not target_keys:
        sys.stderr.write("Error: no cite keys provided.\n")
        sys.stderr.write("Usage: bibdb delete KEY1 [KEY2 ...]  OR  echo KEY | bibdb delete\n")
        conn.close()
        sys.exit(2)

    # 削除対象の存在確認
    cur.execute(
        f"SELECT cite_key FROM entries WHERE cite_key IN ({','.join('?' for _ in target_keys)})",
        target_keys,
    )
    existing = {row[0] for row in cur.fetchall()}
    
    # 見つからないキーの警告
    missing = [k for k in target_keys if k not in existing]
    for k in missing:
        sys.stderr.write(f"Warning: {k} not found.\n")

    delete_keys = [k for k in target_keys if k in existing]
    if not delete_keys:
        sys.stderr.write("Nothing to delete.\n")
        conn.close()
        return

    # 確認プロンプト
    if not args.force:
        sys.stderr.write(f"About to delete {len(delete_keys)} entries from DB: {DB_PATH}\n")
        sys.stderr.write("Proceed? [y/N]: ")
        sys.stderr.flush()

        ans = ""
        try:
            # Unix/Linux/macOS 用
            with open("/dev/tty", "r", encoding="utf-8") as tty:
                ans = tty.readline().strip().lower()
        except OSError:
            try:
                # Windows 用 (CONIN$)
                with open("CONIN$", "r", encoding="utf-8") as conin:
                    ans = conin.readline().strip().lower()
            except OSError:
                # TTYもCONIN$も使えない環境（完全な非対話環境など）
                sys.stderr.write("\nError: Cannot read confirmation (no TTY). Use --force to proceed.\n")
                conn.close()
                sys.exit(1)

        if ans != "y":
            sys.stderr.write("Canceled.\n")
            conn.close()
            return

    # 削除実行
    cur.execute(
        f"DELETE FROM entries WHERE cite_key IN ({','.join('?' for _ in delete_keys)})",
        delete_keys,
    )
    conn.commit()
    sys.stderr.write(f"Deleted {cur.rowcount} entries.\n")
    conn.close()


# -----------------------------------------------------------------------------
# Main Parser
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="BibTeX Database Manager (SQLite)")
    subparsers = parser.add_subparsers(dest="command", required=True, help="Sub-commands")

    # Command: import
    parser_import = subparsers.add_parser("import", help="Import .bib file into DB")
    parser_import.add_argument("bibfile", help="Input .bib or .db file path")
    parser_import.add_argument("--force", "-f", action="store_true", help="Force overwrite conflicts")
    parser_import.set_defaults(func=cmd_import)

    # Command: export
    parser_export = subparsers.add_parser("export", help="Export DB entries to BibTeX")
    parser_export.add_argument("--keys", "-k", help="File with list of cite keys (one per line)")
    parser_export.set_defaults(func=cmd_export)

    # Command: dedup
    parser_dedup = subparsers.add_parser("dedup", help="Find and merge duplicates")
    parser_dedup.add_argument("--threshold", "-t", type=float, default=0.9, help="Similarity threshold (0.0-1.0)")
    parser_dedup.set_defaults(func=cmd_dedup)

    # Command: list
    parser_list = subparsers.add_parser("list", help="List entries for fzf/grep")
    parser_list.set_defaults(func=cmd_list)

    # Command: delete
    parser_delete = subparsers.add_parser("delete", help="Delete entries by cite keys (file or stdin)")
    parser_delete.add_argument("keys_pos", nargs='*', help="Cite keys to delete")
    parser_delete.add_argument("--keys", "-k", help="File with list of cite keys (one per line)")
    parser_delete.add_argument("--force", "-f", action="store_true", help="Delete without confirmation")
    parser_delete.set_defaults(func=cmd_delete)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
