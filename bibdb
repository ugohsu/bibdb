def get_db_entry_dict(cur, cite_key):
    """DBから既存データを取得して辞書形式で返す (比較用)"""
    cur.execute("SELECT id, entry_type FROM entries WHERE cite_key = ?", (cite_key,))
    row = cur.fetchone()
    if not row:
        return None, None
    
    entry_id, entry_type = row
    cur.execute("SELECT field_key, field_value FROM fields WHERE entry_id = ?", (entry_id,))
    
    data = {row[0]: row[1] for row in cur.fetchall()}
    data['ENTRYTYPE'] = entry_type
    return entry_id, data

def show_diff(cite_key, db_data, new_data):
    """Gitライクな差分表示"""
    print(f"\n--- Conflict detected: {cite_key} ---")
    all_keys = sorted(set(db_data.keys()) | set(new_data.keys()))
    
    for key in all_keys:
        if key in ['ID']: continue
        val_db = db_data.get(key)
        val_new = new_data.get(key)
        
        if val_db != val_new:
            print(f"Key: {key}")
            print(f"  - DB : {val_db if val_db is not None else '(Not exists)'}")
            print(f"  + New: {val_new if val_new is not None else '(Deleted)'}")

def upsert_entry(conn, entry, force=False):
    cur = conn.cursor()
    cite_key = entry.get('ID')
    new_type = entry.get('ENTRYTYPE')
    
    if not cite_key or not new_type:
        return

    # 入力データの整形
    # NOTE: ENTRYTYPE は entries.entry_type に保存するため、fields 側には入れない
    new_data = {'ENTRYTYPE': new_type}
    for k, v in entry.items():
        if k is None:
            continue
        kk = str(k).strip()
        if kk.upper() in ("ID", "ENTRYTYPE"):
            continue
        new_data[kk.lower()] = str(v).strip()

    entry_id, db_data = get_db_entry_dict(cur, cite_key)

    # 新規登録
    if not entry_id:
        print(f"[NEW] Adding {cite_key}...")
        cur.execute("INSERT INTO entries (cite_key, entry_type) VALUES (?, ?)", (cite_key, new_type))
        entry_id = cur.lastrowid
        for k, v in new_data.items():
            if k == 'ENTRYTYPE': continue
            cur.execute("INSERT INTO fields (entry_id, field_key, field_value) VALUES (?, ?, ?)",
                        (entry_id, k, v))
        conn.commit()
        return

    # 既存比較
    if db_data == new_data:
        return

    # コンフリクト解決
    if force:
        choice = 'o'
    else:
        show_diff(cite_key, db_data, new_data)
        while True:
            choice = input("Action? [o]verwrite / [s]kip : ").lower()
            if choice in ['o', 's']:
                break

    if choice == 'o':
        print(f"-> Overwriting {cite_key}...")
        cur.execute("UPDATE entries SET entry_type = ? WHERE id = ?", (new_type, entry_id))
        cur.execute("DELETE FROM fields WHERE entry_id = ?", (entry_id,))
        for k, v in new_data.items():
            if k == 'ENTRYTYPE': continue
            cur.execute("INSERT INTO fields (entry_id, field_key, field_value) VALUES (?, ?, ?)",
                        (entry_id, k, v))
        conn.commit()
    else:
        print(f"-> Skipped {cite_key}")

def _parse_bib_file(filepath):
    """バージョンに応じたBibTeXパース処理を行い、辞書のリストを返す"""
    entries = []
    
    with open(filepath, 'r', encoding='utf-8') as f:
        if BIBTEXPARSER_V2:
            # --- v2.x 系の処理 ---
            bib_str = f.read()
            library = bibtexparser.parse_string(bib_str)
            
            for entry in library.entries:
                # v2のEntryオブジェクトをv1互換の辞書に変換
                # entry.fields は Field オブジェクトのリスト
                d = {field.key: field.value for field in entry.fields}
                d['ID'] = entry.key
                d['ENTRYTYPE'] = entry.entry_type
                entries.append(d)
        else:
            # --- v1.x 系の処理 ---
            # 標準マクロ(jan, feb等)を解決するためのパーサー設定
            from bibtexparser.bparser import BibTexParser
            parser = BibTexParser(common_strings=True)
            bib_database = bibtexparser.load(f, parser=parser)
            entries = bib_database.entries
            
    return entries

def _upsert_db_entry_fields(conn, cite_key, entry_type, added_at, src_fields, force=False):
    """DB インポート用: fields のコンフリクト解決（added_at を元の値で保持）"""
    cur = conn.cursor()
    new_data = {'ENTRYTYPE': entry_type}
    new_data.update(src_fields)

    entry_id, db_data = get_db_entry_dict(cur, cite_key)

    if not entry_id:
        print(f"[NEW] Adding {cite_key}...")
        cur.execute(
            "INSERT INTO entries (cite_key, entry_type, added_at) VALUES (?, ?, ?)",
            (cite_key, entry_type, added_at),
        )
        entry_id = cur.lastrowid
        for k, v in src_fields.items():
            cur.execute(
                "INSERT INTO fields (entry_id, field_key, field_value) VALUES (?, ?, ?)",
                (entry_id, k, v),
            )
        conn.commit()
        return

    if db_data == new_data:
        return

    if force:
        choice = 'o'
    else:
        show_diff(cite_key, db_data, new_data)
        while True:
            choice = input("Action? [o]verwrite / [s]kip : ").lower()
            if choice in ['o', 's']:
                break

    if choice == 'o':
        print(f"-> Overwriting {cite_key}...")
        cur.execute("UPDATE entries SET entry_type = ? WHERE id = ?", (entry_type, entry_id))
        cur.execute("DELETE FROM fields WHERE entry_id = ?", (entry_id,))
        for k, v in src_fields.items():
            cur.execute(
                "INSERT INTO fields (entry_id, field_key, field_value) VALUES (?, ?, ?)",
                (entry_id, k, v),
            )
        conn.commit()
    else:
        print(f"-> Skipped {cite_key}")


def _merge_extras_lossless(conn, cite_key, src_extras):
    """cite_key に対して src_extras を lossless マージする（dedup と同一方針）"""
    if not src_extras:
        return
    cur = conn.cursor()
    cur.execute("SELECT id FROM entries WHERE cite_key = ?", (cite_key,))
    row = cur.fetchone()
    if not row:
        return
    entry_id = row[0]

    cur.execute("SELECT extra_key, extra_value FROM extras WHERE entry_id = ?", (entry_id,))
    existing = set(cur.fetchall())

    added = 0
    for k, v in src_extras:
        if (k, v) not in existing:
            cur.execute(
                "INSERT INTO extras (entry_id, extra_key, extra_value) VALUES (?, ?, ?)",
                (entry_id, k, v),
            )
            added += 1
    if added:
        conn.commit()


def _merge_figure_notes_lossless(conn, cite_key, src_notes):
    """cite_key に対して src_notes (label, memo, image_data, image_mime, sort_order) を
    lossless マージする（完全一致する画像メモは重複追加しない、dedup と同一方針）"""
    if not src_notes:
        return
    cur = conn.cursor()
    cur.execute("SELECT id FROM entries WHERE cite_key = ?", (cite_key,))
    row = cur.fetchone()
    if not row:
        return
    entry_id = row[0]

    cur.execute(
        "SELECT label, memo, image_data, image_mime FROM figure_notes WHERE entry_id = ?",
        (entry_id,),
    )
    existing = set(cur.fetchall())

    cur.execute("SELECT MAX(sort_order) FROM figure_notes WHERE entry_id = ?", (entry_id,))
    next_order = (cur.fetchone()[0] or -1) + 1

    added = 0
    for label, memo, image_data, image_mime, _src_order in src_notes:
        if (label, memo, image_data, image_mime) in existing:
            continue
        cur.execute(
            "INSERT INTO figure_notes (entry_id, label, memo, image_data, image_mime, sort_order) "
            "VALUES (?, ?, ?, ?, ?, ?)",
            (entry_id, label, memo, image_data, image_mime, next_order),
        )
        next_order += 1
        added += 1
    if added:
        conn.commit()


def _import_from_db(args):
    """bibdb 互換 .db ファイルをターゲット DB にインポートする"""
    src_path = args.bibfile

    src_conn = sqlite3.connect(src_path)
    src_cur = src_conn.cursor()

    # スキーマ互換チェック（必須テーブルの存在確認）
    # figure_notes は新しめのテーブルなので任意（無ければ画像メモなしのDBとして扱う）
    src_cur.execute("SELECT name FROM sqlite_master WHERE type='table'")
    tables = {row[0] for row in src_cur.fetchall()}
    missing = {'entries', 'fields', 'extras'} - tables
    if missing:
        src_conn.close()
        sys.exit(f"Error: Source DB is missing required tables: {', '.join(sorted(missing))}")
    has_figure_notes = 'figure_notes' in tables

    src_cur.execute("SELECT id, cite_key, entry_type, added_at FROM entries")
    src_entries = src_cur.fetchall()

    conn = get_connection()
    init_db(conn)

    print(f"Reading {src_path}...")
    print(f"Processing {len(src_entries)} entries from {src_path}...")
    print(f"Target DB: {DB_PATH}")

    for src_id, cite_key, entry_type, added_at in src_entries:
        src_cur.execute(
            "SELECT field_key, field_value FROM fields WHERE entry_id = ?", (src_id,)
        )
        src_fields = {k: v for k, v in src_cur.fetchall()}

        src_cur.execute(
            "SELECT extra_key, extra_value FROM extras WHERE entry_id = ?", (src_id,)
        )
        src_extras = src_cur.fetchall()

        _upsert_db_entry_fields(conn, cite_key, entry_type, added_at, src_fields, args.force)
        _merge_extras_lossless(conn, cite_key, src_extras)

        if has_figure_notes:
            src_cur.execute(
                "SELECT label, memo, image_data, image_mime, sort_order "
                "FROM figure_notes WHERE entry_id = ?",
                (src_id,),
            )
            src_notes = src_cur.fetchall()
            _merge_figure_notes_lossless(conn, cite_key, src_notes)

    src_conn.close()
    conn.close()
    print("Done.")


def cmd_import(args):
    if args.bibfile.endswith('.db'):
        _import_from_db(args)
        return

    if not BIBTEXPARSER_AVAILABLE:
        sys.exit("Error: 'bibtexparser' module is required. (apt install python3-bibtexparser)")

    conn = get_connection()
    init_db(conn)

    print(f"Reading {args.bibfile}...")
    try:
        entries = _parse_bib_file(args.bibfile)
    except Exception as e:
        sys.exit(f"Error parsing .bib file: {e}")

    print(f"Processing {len(entries)} entries from {args.bibfile}...")
    print(f"Target DB: {DB_PATH}")

    for entry in entries:
        upsert_entry(conn, entry, force=args.force)

    conn.close()
    print("Done.")

