def get_bib_entry_str(cur, cite_key):
    cur.execute("SELECT id, entry_type FROM entries WHERE cite_key = ?", (cite_key,))
    row = cur.fetchone()
    if not row:
        sys.stderr.write(f"Warning: {cite_key} not found.\n")
        return None
    
    entry_id, entry_type = row
    cur.execute("SELECT field_key, field_value FROM fields WHERE entry_id = ?", (entry_id,))
    # 出力順を安定させるためキーでソート
    fields = sorted(cur.fetchall(), key=lambda x: x[0])
    
    lines = [f"@{entry_type}{{{cite_key},"]
    for k, v in fields:
        lines.append(f"  {k} = {{{v}}},")
    lines.append("}\n")
    return "\n".join(lines)

def cmd_export(args):
    conn = get_connection()
    cur = conn.cursor()
    target_keys = []

    if args.keys:
        if not os.path.exists(args.keys):
            sys.stderr.write(f"Error: File not found: {args.keys}\n")
            conn.close()
            sys.exit(2)
        with open(args.keys, 'r', encoding='utf-8') as f:
            target_keys = [line.strip() for line in f if line.strip()]
    else:
        # stdin があればそれを使う。なければ全件
        if not sys.stdin.isatty():
            target_keys = [line.strip() for line in sys.stdin if line.strip()]
        else:
            cur.execute("SELECT cite_key FROM entries")
            target_keys = [row[0] for row in cur.fetchall()]

    for key in target_keys:
        bib_str = get_bib_entry_str(cur, key)
        if bib_str:
            print(bib_str)
    
    conn.close()

